DEV_OTP_MAX_ATTEMPTS=5

DEV_RATE_LIMIT_WINDOW_MINUTES=15
DEV_RATE_LIMIT_GLOBAL_MAX=300
DEV_RATE_LIMIT_AUTH_MAX=20

